PUBLIC_BASE_URL=
FRONTEND_PORT=5173
PORT=8787
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=rh_stream
MONGODB_PLAYBACK_COLLECTION=playback_progress
MONGODB_STREAMING_HISTORY_COLLECTION=streaming_history
MONGODB_XTREAM_COLLECTION=xtream_sources
MONGODB_FAVORITES_COLLECTION=favorites
MONGODB_AI_RECOMMENDATIONS_COLLECTION=ai_recommendations
MONGODB_DEVICE_COLLECTION=device_profiles
MONGODB_ACCOUNT_PROFILE_COLLECTION=account_profiles
MAX_ACCOUNT_PROFILES=5
DEVICE_AUTH_SECRET=replace-with-a-long-random-production-secret
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash
MAX_SAVED_AI_SAMPLE=32
MAX_AI_CANDIDATES=100
MAX_DESCRIPTION_LENGTH=200
MAX_GEMINI_RETRIES=2

# Android app distribution
GITHUB_REPOSITORY=rudyhamame/stream_front
GITHUB_RELEASE_TAG=android-latest
ANDROID_APP_ASSET_NAME=RH-IPTV-Library.apk
ANDROID_APP_DOWNLOAD_URL=https://github.com/rudyhamame/stream_front/releases/latest/download/RH-IPTV-Library.apk
