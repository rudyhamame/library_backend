TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION=
# Optional allowlist. Leave blank to browse channels available to the signed-in account.
TELEGRAM_CHANNELS=
TELEGRAM_SESSION_FILE=.telegram-session
# Allow FFmpeg's beginning-of-file and MP4-index range reads to run together.
TELEGRAM_MAX_STREAMS=2
LOCAL_MEDIA_DIR=media/movies
LOCAL_MEDIA_CONFIG_PATH=data/local-media.json
DLNA_DATA_DIR=data/dlna
PUBLIC_BASE_URL=
FRONTEND_PORT=5173
PORT=8787
FFMPEG_PATH=ffmpeg
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=rh_stream
MONGODB_PLAYLIST_COLLECTION=playlists
MONGODB_PLAYBACK_COLLECTION=playback_progress
MONGODB_IPTV_COLLECTION=iptv_sources
